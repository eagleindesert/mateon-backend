# scripts/debug/.env — CORS 검사, 카카오 토큰 교환, Node.js 채팅 런처 공용
# cp scripts/debug/.env.example scripts/debug/.env 후 필요한 도구의 값을 채우세요.
# 파일 값이 셸 환경변수보다 우선합니다. 값 뒤에 인라인 주석을 붙이지 마세요.

# CORS 검사 / Node.js 채팅: 백엔드 주소 (끝에 / 없이)
MATEON_BASE_URL=http://localhost:8080

# Node.js 채팅: 이미 가입된 서로 다른 A/B 계정 (필수)
MATEON_TEST_EMAIL=
MATEON_TEST_PASSWORD=
MATEON_USERB_EMAIL=
MATEON_USERB_PASSWORD=

# 카카오 토큰 교환: REST API 키 필수, client secret은 활성화한 앱만 필요
MATEON_KAKAO_REST_API_KEY=
MATEON_KAKAO_CLIENT_SECRET=
# 카카오 개발자 콘솔에 등록한 Redirect URI와 정확히 일치해야 합니다.
MATEON_KAKAO_REDIRECT_URI=http://localhost:8080/debug/oauth
# get-kakao-token.sh가 획득한 토큰을 이 파일에 자동 기록합니다.
# API 인증 테스트에서 쓰려면 scripts/test/.env의 같은 키에 복사하거나
# --kakao-access-token 옵션으로 전달하세요.
MATEON_KAKAO_ACCESS_TOKEN=

# AI 스텁은 환경변수 설정 없이 CLI 옵션으로 실행합니다:
# stub-ai-server.sh: --port 8000 --embedding-dimension 1536 --expected-secret VALUE
# stub-spring-ai-server.sh: --port 8001 --force-domain DOMAIN --failure-mode MODE
# start-all.sh: 위 AI 옵션 + --router-port / --router-force-domain /
#              --router-failure-mode / --no-router-stub
# DOMAIN: MATCHING_INTENT, UNCLEAR, OUT_OF_SCOPE
# MODE: none, broken-json, unknown-domain, empty-domain, http-500, temperature-400
# 백엔드 AI_BASE_URL, AI_INTERNAL_SECRET, DB/JWT 등은 루트 .env / .env.secret에서
# 관리합니다. start-all.sh는 루트 .env.secret의 AI_INTERNAL_SECRET을 요구합니다.
# --expected-secret을 쓰면 백엔드 AI_INTERNAL_SECRET과 값을 맞추세요.
# OAuth 완료 페이지를 쓰려면 백엔드 설정 debug.oauth.enabled=true도 필요합니다.
