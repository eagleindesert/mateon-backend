# scripts/test/.env — for-api와 parallel-chat의 공용 설정
# cp scripts/test/.env.example scripts/test/.env 후 계정 정보를 채우세요.
# 우선순위: CLI 옵션 > 이 파일 > 셸 환경변수 > 스크립트 기본값
# 값 뒤에 인라인 주석을 붙이지 마세요.

# 백엔드 주소 (끝에 / 없이)
MATEON_BASE_URL=http://localhost:8080

# 사용자 A: 인증 및 일반 API 테스트
MATEON_TEST_EMAIL=
MATEON_TEST_PASSWORD=
MATEON_TEST_NAME=테스트유저

# 사용자 B: A와 다른 계정. 팀/채팅/추천/리뷰 시나리오에서 사용
MATEON_USERB_EMAIL=
MATEON_USERB_PASSWORD=
MATEON_USERB_NAME=채팅메이트

# 사용자 C: A/B와 다른 계정. 09_three_users 및 전체 테스트에서 필요
MATEON_USERC_EMAIL=
MATEON_USERC_PASSWORD=
MATEON_USERC_NAME=협업메이트

# 선택: 학교 인증 대상 이메일. 07_school_auth는 비우면 A 이메일 사용
# 00_before_auth의 정리 SQL 생성 대상에도 포함됩니다.
MATEON_SCHOOL_EMAIL=

# 선택: 실제 카카오 로그인 정상 경로 검증용 액세스 토큰
# scripts/debug/oauth/get-kakao-token.sh가 scripts/debug/.env에 기록한 값을 복사하세요.
MATEON_KAKAO_ACCESS_TOKEN=

# 선택: ./gradlew liveTest 전용. API Bash 테스트에는 사용되지 않습니다.
# Gradle은 이 파일을 자동 로드하지 않으므로 활성화 후 실행 전에:
#   set -a
#   source scripts/test/.env
#   set +a
# AI_STUB_BASE_URL=http://localhost:8000
# AI_STUB_SECRET=stub-secret
# 시크릿 검증을 켠 스텁의 --expected-secret과 AI_STUB_SECRET을 맞추세요.
# AI_STUB_BASE_URL 미설정 시 LiveTest는 전건 건너뜁니다. 저장 테스트에는 Docker도 필요합니다.

# 별도 파일을 쓸 때는 실행 전에 MATEON_ENV_FILE=/absolute/path/to/config를 지정하세요.
# MATEON_ENV_FILE은 이 파일을 찾는 선택자이므로 여기에 설정하지 않습니다.
# 액세스/리프레시 토큰과 테스트 생성 ID는 for-api 하위 파일에 자동 저장됩니다.
