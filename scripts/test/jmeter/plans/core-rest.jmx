        </HTTPSamplerProxy>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="북마크 삭제" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
