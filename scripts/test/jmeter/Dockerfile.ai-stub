FROM ghcr.io/astral-sh/uv:0.12.17-python3.12-bookworm-slim
WORKDIR /opt/mateon
COPY scripts/etc/colors.py scripts/etc/http_body.py ./scripts/etc/
COPY scripts/debug/ai-stub/_stub_ai_server.py ./scripts/debug/ai-stub/
ENV UV_NO_CACHE=1 UV_PYTHON_DOWNLOADS=never PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT ["uv", "run", "--offline", "--no-project", "python", "scripts/debug/ai-stub/_stub_ai_server.py"]
