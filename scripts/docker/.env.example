# scripts/docker/.env — 루트 build-push.sh가 자격증명 두 항목을 자동 로드한다.
# cp scripts/docker/.env.example scripts/docker/.env 후 사용자명을 채우세요.
# 인라인 주석은 사용하지 않는다. 값 전체를 감싼 따옴표는 지원한다.

# 필수: DockerHub 사용자명 (--username 옵션으로도 지정 가능)
DOCKERHUB_USERNAME=
# 선택: DockerHub 액세스 토큰. 비우면 기존 docker login 세션을 사용합니다.
DOCKERHUB_TOKEN=

# 아래 설정은 next-dockerhub-tag.sh를 단독 실행할 때 사용한다.
# 단독 실행 시 자동 로드하지 않으므로 먼저 set -a; source scripts/docker/.env; set +a
# build-push.sh에서는 셸 환경변수 또는 --image-name을 사용한다.
DOCKERHUB_IMAGE=mateon-backend
# 조회 실패 또는 기존 semver 태그가 없을 때 사용할 시작 버전
START_VERSION=v1.0.0
# patch / minor / major
BUMP=patch
# 직접 지정하면 조회 및 BUMP를 생략합니다 (예: v1.2.3).
# build-push.sh에서는 --tag 옵션으로 지정한다.
TAG=

# 배포 옵션은 환경변수 대신 CLI로 지정합니다:
# --image-name mateon-backend --platform linux/arm64 --tag v1.2.3
# --no-latest: latest 태그 생략 / --no-push: 로컬 빌드 및 로드만 수행
# GITHUB_OUTPUT은 GitHub Actions runner가 공급하므로 설정하지 않습니다.
# Docker Compose 및 백엔드 런타임 설정은 루트 .env / .env.secret에서 관리합니다.
