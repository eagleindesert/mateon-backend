# ==============================================================================
# .env.secret 템플릿 — 이 파일을 .env.secret 으로 복사해서 값을 채운다.
# ==============================================================================
#   cp .env.secret.example .env.secret      (Windows: Copy-Item .env.secret.example .env.secret)
#
# 유출되면 사고가 나는 값, 그리고 우리 계정을 특정하는 식별자를 여기 둔다.
# 포트·오리진·이미지 태그·DB 계정 같은 설정은 .env 로 가고, 그쪽 템플릿은 .env.example 이다.
#
# 로컬 Compose·bootRun·배포 Compose 모두 이 파일을 읽는다.
# 일반 앱에는 환경변수로 주입하고, postgres에는 DB 변수만 전달한다.
# 테스트 앱에는 이 파일의 실제 자격증명을 주입하지 않는다.
#
# start.sh는 두 파일을 Compose 치환에도 사용하므로 POSTGRES_PASSWORD도 여기에 둘 수 있다.
# 직접 Compose나 별도 pgAdmin을 실행한다면 --env-file .env --env-file .env.secret을 지정한다.
# POSTGRES_PASSWORD=
#
# 아래 아홉 개는 모두 값이 필요하다. 비워 두면 부팅이 실패하거나(JWT_SECRET,
# AI_INTERNAL_SECRET, OCI_*) 해당 기능이 죽는다. 예외는 OPENAI_API_KEY 하나다.

# --- Gmail SMTP (인증 메일 발송) ---
# 비밀번호는 계정 비밀번호가 아니라 Google 계정 > 보안 > 앱 비밀번호에서 발급한 16자다.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- 카카오 (웹 인가코드 교환) ---
# RN 액세스 토큰 경로에는 필요 없다. 웹 React 콜백 플로우만 이 키를 쓴다.
# 콘솔 > 앱 키 > REST API 키. client secret 은 콘솔에서 켠 앱만.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# --- JWT ---
# HS256 서명 키. 최소 32바이트 이상의 아무 문자열이면 된다.
# 이 값이 바뀌면 이미 발급된 토큰이 전부 무효가 된다(= 전원 로그아웃).
JWT_SECRET=

# --- AI (FastAPI 서버) ---
# 의도 추출·임베딩을 담당하는 별도 서버. 로컬에서 직접 띄웠다면 http://localhost:8000 이다.
# 시크릿은 그 서버와 같은 값이어야 하고, 없으면
# AiServerProperties.validateInternalSecret 가 부팅을 막는다.
AI_BASE_URL=
AI_INTERNAL_SECRET=

# --- AI 게이트웨이 (도메인 라우터) ---
# 비워 두어도 앱은 뜨지만, 라우터가 실패로 보고 모든 발화를 매칭 의도 추출로
# 통과시킨다(= 게이트웨이 도입 전 동작). 모델명 등 나머지 설정은 .env 에 있다.
OPENAI_API_KEY=

# --- OCI Object Storage (S3 호환 API) ---
# 액세스 키 한 쌍은 OCI 콘솔 > 사용자 > Customer Secret Keys 에서 발급한다.
# 시크릿은 발급 직후 한 번만 보여 주므로 그때 저장해 둔다.
# 리전/버킷은 .env 에 있다 — 네임스페이스만 테넌시를 특정하므로 이쪽에 둔다.
OCI_NAMESPACE=
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=
