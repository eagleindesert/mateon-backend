# ==============================================================================
# .env 템플릿 — 이 파일을 .env 로 복사해서 값을 채운다.
# ==============================================================================
#   cp .env.example .env      (Windows: Copy-Item .env.example .env)
#
# 설정은 두 파일로 나뉜다. 둘 다 gitignore 되고, 커밋되는 건 템플릿 두 개뿐이다.
#
#   .env         이 파일. 새어 나가도 우리를 특정하지 못하는 설정.
#   .env.secret  메일 계정·JWT 키·API 키, 그리고 우리 계정을 특정하는 식별자
#                (AI 서버 주소, OCI 네임스페이스). 템플릿은 .env.secret.example
#
# 이 파일에 남는 건 두 종류다:
#   1) compose 가 파일을 파싱할 때 읽어야 하는 값 — ${...} 치환은 .env 만 본다.
#      그래서 POSTGRES_PASSWORD 처럼 시크릿인데도 옮길 수 없는 값이 있다. 아래 참고.
#   2) 포트, 만료 시간, 모델명, 로그 레벨처럼 그 자체로는 아무것도 알려 주지 않는 설정.
#
# 값 표기 규칙
#   (필수)  — 기본값이 없다. 비우면 부팅이 실패하거나 해당 기능이 죽는다.
#   (선택)  — application*.yml 에 기본값이 있다. 그대로 쓸 거면 줄을 지워도 된다.
#             주석 처리해 둔 줄이 곧 "기본값이 이거다" 라는 뜻이다.
#
# 이름에 점(.)을 쓰지 않는다. 배포 compose 가 env_file 로 이 파일을 통째로 환경변수화하는데,
# 그렇게 들어간 debug.oauth.enabled 는 환경변수 우선순위가 프로필 yml 보다 높아
# application-prod.yml 의 false 를 조용히 이겨 버린다. 대문자 이름은 프로필이 명시적으로
# ${...} 로 받는 자리라 그런 사고가 없다.


# ==============================================================================
# Compose 치환용 (배포 서버에서만 필요)
# ==============================================================================
# 여기 있는 값만 성격이 다르다 — 컨테이너 안으로 들어가는 게 아니라,
# docker-compose-deployment.yml 의 ${...} 자리에 치환되어 들어간다. 그래서 이 블록은
# 반드시 compose 파일과 같은 디렉터리의 .env 에 있어야 한다 —
# .env.secret 이나 env_file 로 주입되는 값은 치환에 쓰이지 않는다.
#
# 비밀번호 두 개가 시크릿인데도 .env.secret 이 아니라 여기 있는 이유가 그거다.
# 옮기면 에러도 경고도 없이 compose 기본값 admin 으로 폴백한다.
#
# 로컬 개발(docker-compose.yml)에는 필요 없다 — 전부 주석인 채로 두면 기본값이 쓰인다.
# 배포 서버의 .env 에서는 비밀번호 두 개를 반드시 채운다.

# pull 해 올 DockerHub 이미지: ${DOCKERHUB_USERNAME}/mateon-backend:${TAG}
# DOCKERHUB_USERNAME=eagleindesert
# TAG=latest

# postgres 컨테이너 계정. app 의 DB 접속 정보로도 그대로 쓰인다.
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=admin

# pgAdmin 로그인 계정.
# PGADMIN_DEFAULT_EMAIL=admin@admin.com
# PGADMIN_DEFAULT_PASSWORD=admin

# 호스트에 노출할 포트. 8080 이 아니라 8081 인 건 호스트 쪽 충돌을 피하려는 것뿐이고,
# 컨테이너 안은 계속 8080 이다.
# APP_PORT=8081
# PGADMIN_PORT=5050
# POSTGRES_PORT=5433


# ==============================================================================
# Key / Account Config
# ==============================================================================

# Gmail SMTP 계정(MAIL_USERNAME/MAIL_PASSWORD)은 .env.secret 으로 간다.

# JWT 만료 시간(ms). 아래가 기본값 — access 24시간 / refresh 7일.
# 서명 키는 .env.secret 의 JWT_SECRET.
# JWT_EXPIRATION=86400000
# JWT_REFRESH_EXPIRATION=604800000


# ==============================================================================
# AI Config
# ==============================================================================

# AI (FastAPI 서버) 주소와 공유 시크릿(AI_BASE_URL/AI_INTERNAL_SECRET)은 .env.secret 으로 간다.

# AI 게이트웨이 (도메인 라우터) — Spring AI 가 직접 부르는 유일한 LLM.
# 키(.env.secret 의 OPENAI_API_KEY)를 비우면 앱은 뜨지만 라우터가 실패로 보고
# 모든 발화를 매칭 의도 추출로 통과시킨다(= 게이트웨이 도입 전 동작).
# AI_ROUTER_MODEL=gpt-5-mini
# AI_ROUTER_ENABLED=true

# 타임아웃/세션 관련. 손댈 일은 거의 없다.
# AI_CONNECT_TIMEOUT=5s
# AI_READ_TIMEOUT=120s
# AI_SESSION_TTL=24h


# ==============================
# OCI Object Storage (S3 호환 API)
# ==============================
# 공모전 포스터 이미지 업로드에 사용. 아래 둘은 (필수) 다 — 채우지 않으면 부팅은 되지만
# 업로드가 502 로 실패한다.
# 네임스페이스와 액세스 키 한 쌍(OCI_NAMESPACE/OCI_S3_*)은 .env.secret 으로 간다.
OCI_REGION=
OCI_BUCKET=

# 버킷 사용량 상한과 집계 크론. 상한을 넘기면 업로드를 막는다.
# OCI_BUCKET_MAX_BYTES=2GB
# OCI_BUCKET_USAGE_SYNC_CRON=0 30 4 * * *


# ==============================================================================
# Prod / Debug Config
# ==============================================================================
# 여기 있는 값은 프로필(application-dev.yml / application-prod.yml)의 기본값을 덮어쓴다.
# 기본값이 프로필마다 다른 항목은 "dev / prod" 로 병기했다.

# 허용 오리진 (REST + STOMP 공통). 콤마로 구분한다.
# dev 기본값은 "*"(전체 허용)이라 로컬에서는 보통 비워 둔다.
# prod 에서는 (필수) 다 — 기본값이 없어 이 값이 없으면 부팅이 실패한다.
#   예) CORS_ALLOWED_ORIGINS=https://mateon.example.com,https://www.mateon.example.com
# CORS_ALLOWED_ORIGINS=

# 카카오 인가코드 수신 디버그 컨트롤러(/debug/**) 등록 여부.  dev: true / prod: false
# 배포 서버는 dev 프로필로 도는 탓에 기본이 열림이다. 닫으려면 false 를 명시한다.
# DEBUG_OAUTH_ENABLED=true

# Swagger UI 노출 (dev·prod 모두 기본 true). 운영에서 닫으려면 false.
# /v3/api-docs 는 이 값과 무관하게 계속 열려 있다.
# SWAGGER_UI_ENABLED=true

# SQL 로그. dev·prod 모두 기본이 꺼짐이다 — 배포 서버가 dev 프로필로 도는 탓에,
# 로컬 편의로 켜 둔 기본값이 그대로 서버 로그에 쌓였다.
# 로컬에서 쿼리를 보려면 둘을 세트로 켠다(한쪽만 켜면 System.out 이나 로거 중 한 곳만 열린다).
# JPA_SHOW_SQL=true
# LOG_LEVEL_SQL=DEBUG

# 앱 로그 레벨.  dev: DEBUG / prod: INFO
# 배포 서버를 더 조용히 시키려면 INFO 를 준다.
# LOG_LEVEL_APP=INFO

# HikariCP 커넥션 풀.  dev: 10 / prod: 20
# DB_POOL_SIZE=10
# DB_LEAK_DETECTION_MS=20000

# 커넥션 풀 로그. dev·prod 모두 기본이 INFO(= 사실상 꺼짐)다.
# DEBUG 를 주면 30초마다 풀 상태(total/active/idle/waiting)와 커넥션 추가·폐기,
# 부팅 시 설정 덤프가 찍힌다. 풀 고갈을 쫓을 때만 켜고 끝나면 지운다.
# 누수 경고(DB_LEAK_DETECTION_MS)는 WARN 이라 이 값과 상관없이 항상 나온다.
# LOG_LEVEL_POOL=DEBUG

# 업로드 용량 상한. 포스터 이미지 기준이라 파일 20MB / 요청 24MB 다.
# MULTIPART_MAX_FILE_SIZE=20MB
# MULTIPART_MAX_REQUEST_SIZE=24MB

# 알림 SSE 연결 유지 시간.
# NOTIFICATION_SSE_TIMEOUT=1h

# 협업 후기 작성 가능 기간(일)과 자동 완료 처리 크론.
# COLLABORATION_REVIEW_WINDOW_DAYS=14
# COLLABORATION_AUTO_COMPLETE_CRON=0 0 3 * * *
